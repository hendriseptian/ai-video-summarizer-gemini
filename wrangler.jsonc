{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-video-summarizer",
  "main": "src/main.py",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "python_workers"
  ],
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "QUOTA_KV"
    }
  ]
}
